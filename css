
/* =========================================
   KAIZZ AI - LUXURY TRADING TERMINAL
   STYLE.CSS
========================================= */

:root {
  --gold-grad: linear-gradient(
    135deg,
    #F3E5AB 0%,
    #D4AF37 50%,
    #997A15 100%
  );

  --obsidian-glass: rgba(13, 14, 18, 0.78);
}

/* BODY */

body {
  background-color: #070709;
  color: #F4F4F6;
  font-family: 'Plus Jakarta Sans', sans-serif;
  overflow-x: hidden;

  background-image:
    radial-gradient(
      circle at 18% 12%,
      rgba(212,175,55,0.08) 0%,
      transparent 42%
    ),
    radial-gradient(
      circle at 85% 75%,
      rgba(184,134,11,0.07) 0%,
      transparent 45%
    );
}

/* GOLD TEXT */

.text-gold-metallic {
  background: linear-gradient(
    135deg,
    #FFF5CC 0%,
    #D4AF37 48%,
    #AA8218 100%
  );

  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;

  text-shadow: 0 2px 18px rgba(212,175,55,0.18);
}

/* GLASS CARD */

.kaizz-glass {
  background: linear-gradient(
    160deg,
    rgba(20,22,29,0.85) 0%,
    rgba(9,10,13,0.92) 100%
  );

  backdrop-filter: blur(16px);
  -webkit-backdrop-filter: blur(16px);

  border: 1px solid rgba(212,175,55,0.24);

  box-shadow:
    0 18px 45px rgba(0,0,0,0.7),
    inset 0 1px 0 rgba(243,229,171,0.12);
}

.kaizz-glass-hover {
  transition:
    transform 0.25s cubic-bezier(0.22,1,0.36,1),
    border-color 0.3s ease,
    box-shadow 0.3s ease;

  transform-style: preserve-3d;
}

.kaizz-glass-hover:hover {
  border-color: rgba(243,229,171,0.55);

  box-shadow:
    0 22px 55px rgba(0,0,0,0.85),
    0 0 28px rgba(212,175,55,0.18);
}

/* GOLD BUTTON */

.btn-gold-luxury {
  background: linear-gradient(
    135deg,
    #F3E5AB 0%,
    #D4AF37 52%,
    #9C7A16 100%
  );

  color: #070709;
  font-weight: 800;
  letter-spacing: 0.08em;

  box-shadow:
    0 8px 25px rgba(212,175,55,0.35),
    inset 0 1px 1px rgba(255,255,255,0.65);

  transition: all 0.25s ease;
  position: relative;
  overflow: hidden;
}

.btn-gold-luxury::after {
  content: '';
  position: absolute;
  top: -50%;
  left: -60%;
  width: 40%;
  height: 200%;

  background: linear-gradient(
    to right,
    transparent,
    rgba(255,255,255,0.55),
    transparent
  );

  transform: rotate(25deg);
  transition: left 0.65s ease;
}

.btn-gold-luxury:hover::after {
  left: 130%;
}

.btn-gold-luxury:hover {
  transform: translateY(-2px);
  box-shadow: 0 12px 32px rgba(243,229,171,0.5);
}

.btn-gold-luxury:active {
  transform: translateY(0);
}

/* TICKER */

@keyframes tickerScroll {
  0% { transform: translateX(0); }
  100% { transform: translateX(-50%); }
}

.animate-ticker {
  display: flex;
  width: max-content;
  animation: tickerScroll 34s linear infinite;
}

.animate-ticker:hover {
  animation-play-state: paused;
}

/* LASER SWEEP */

@keyframes laserSweep {
  0% {
    top: 0%;
    opacity: 0.2;
  }

  50% {
    opacity: 1;
  }

  100% {
    top: 100%;
    opacity: 0.2;
  }
}

.laser-beam {
  position: absolute;
  left: 0;
  right: 0;
  height: 3px;

  background: linear-gradient(
    90deg,
    transparent,
    #F3E5AB,
    #D4AF37,
    #F3E5AB,
    transparent
  );

  box-shadow: 0 0 22px 4px rgba(212,175,55,0.85);

  animation: laserSweep 1.35s ease-in-out infinite alternate;

  pointer-events: none;
  z-index: 30;
}

/* SCROLLBAR */

::-webkit-scrollbar {
  width: 6px;
  height: 6px;
}

::-webkit-scrollbar-track {
  background: #070709;
}

::-webkit-scrollbar-thumb {
  background: rgba(212,175,55,0.35);
  border-radius: 9999px;
}

::-webkit-scrollbar-thumb:hover {
  background: rgba(212,175,55,0.65);
}

/* RESPONSIVE */

canvas {
  max-width: 100%;
}

@media (max-width: 640px) {
  .font-display {
    letter-spacing: 0.04em;
  }
}
